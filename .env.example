# Copy to .env and adjust. Never commit .env.

# PostgreSQL (used by docker-compose.yml)
POSTGRES_USER=business_platform
POSTGRES_PASSWORD=change-me
POSTGRES_DB=business_platform
POSTGRES_PORT=5432

# Backend
DATABASE_URL=postgresql+psycopg://business_platform:change-me@localhost:5432/business_platform
CORS_ORIGINS=["http://localhost:3000"]

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
