# Copy to .env and adjust. Never commit .env.

# PostgreSQL (used by docker-compose.yml)
POSTGRES_USER=business_platform
POSTGRES_PASSWORD=change-me
POSTGRES_DB=business_platform
POSTGRES_PORT=5432
# Separate server for automated tests (docker compose up -d postgres-test). Never the dev database.
POSTGRES_TEST_DB=business_platform_test
POSTGRES_TEST_PORT=5433

# Backend
DATABASE_URL=postgresql+psycopg://business_platform:change-me@localhost:5432/business_platform
CORS_ORIGINS=["http://localhost:3000"]
# pytest and the Playwright backend use ONLY this (the database name must end in _test).
TEST_DATABASE_URL=postgresql+psycopg://business_platform:change-me@localhost:5433/business_platform_test

# Backend identity.
#   AUTH_MODE=dev      the development identity header (APP_ENV=development only); what `.env.example` uses.
#   AUTH_MODE=session  real authentication: email + password (Argon2id) and server-side sessions. The ONLY mode
#                      allowed with APP_ENV=production, which also requires SECURITY_KEY.
#   AUTH_MODE=disabled nobody is authenticated.
# APP_ENV defaults to production and AUTH_MODE to disabled: unless this file opts in, nothing starts.
APP_ENV=development
AUTH_MODE=dev
DEV_USER_EMAIL=fredrik@dev.test

# Session authentication (AUTH_MODE=session). Everything below has a default except SECURITY_KEY in production.
#   SECURITY_KEY=<at least 32 random characters>   # HMAC key for login identifiers in security events
#   PUBLIC_ORIGIN=http://localhost:3000            # used to print operator setup links
#   TRUST_CLIENT_IP_HEADER=false                   # true ONLY behind the BFF, with FastAPI reachable from it alone
#   SESSION_IDLE_HOURS=12  SESSION_ABSOLUTE_DAYS=7  SESSION_MAX_PER_USER=20
#   ARGON2_MEMORY_KIB=65536  ARGON2_TIME_COST=3  ARGON2_PARALLELISM=1   # tune on the deployment hardware
#   ARGON2_MAX_CONCURRENT=4  ARGON2_MAX_WAITING=8  ARGON2_WAIT_SECONDS=2
#   THROTTLE_WINDOW_SECONDS=900  THROTTLE_SOURCE_MAX_FAILURES=30  THROTTLE_PAIR_MAX_FAILURES=5
#   THROTTLE_IDENTIFIER_MAX_FAILURES=50  THROTTLE_GLOBAL_MAX_FAILURE_EVENTS=5000
#   SECURITY_EVENT_RETENTION_DAYS=30  AUTH_RECORD_RETENTION_DAYS=30

# Production (APP_ENV=production) is described in README.md and docs/architecture.md; its backend variables are NOT meant
# for this file. In short: DATABASE_URL is the restricted APP role; the migration job (python -m app.scripts.migrate) takes
# MIGRATION_DATABASE_URL (the schema owner) and RUNTIME_DB_ROLE; BFF_INTERNAL_SECRET (32+ characters) must be set on the
# backend AND the frontend; PUBLIC_ORIGIN must be https; CORS_ORIGINS must be [].
# Development: MIGRATION_DATABASE_URL is optional (migrations then use DATABASE_URL). BFF_INTERNAL_SECRET is optional; when
# set (here AND in frontend/.env.local) it is enforced, so the whole chain can be tried locally.
#   BFF_INTERNAL_SECRET=<32+ random characters>

# Frontend: put these in frontend/.env.local (the frontend does not read this file)
#   BACKEND_URL=http://localhost:8000
#   AUTH_MODE=dev          # development sign-in at /dev-login; needs APP_ENV=development
#   APP_ENV=development
#   (real login instead: AUTH_MODE=session and PUBLIC_ORIGIN=http://localhost:3000;
#    optional TRUSTED_PROXY_HOPS=0, the number of reverse proxies in front of the BFF; leave 0 until the deployment's
#    proxy chain is verified)
#   BFF_INTERNAL_SECRET=<the same value as the backend's, when the backend enforces one>

# --- Operator only: deploying staging through the Coolify API (never needed to run the app) -----------------------
# Coolify sits behind Cloudflare Access, so every API call also needs an Access service token. See
# deploy/coolify/README.md for the deployment order (migrate, then backend, then frontend). Real values go in .env only.
COOLIFY_URL=
COOLIFY_TOKEN=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=
