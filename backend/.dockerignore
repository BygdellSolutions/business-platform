# Build context = backend/. Nothing development-only, nothing secret, nothing host-specific goes into an image.

# the host's environments and caches (the image builds its own)
.venv
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
.mypy_cache

# tests and development tooling
tests
app/scripts/seed_dev.py
app/scripts/reset_test_db.py

# secrets and local configuration
.env
.env.*
**/.env
**/.env.*
*.pem
*.key

# not needed at run time
Dockerfile
.dockerignore
